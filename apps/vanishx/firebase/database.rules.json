{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".validate": "!newData.exists() || (newData.hasChildren(['createdAt', 'expiresAt', 'hostPro']) && newData.child('createdAt').isNumber() && newData.child('expiresAt').isNumber() && (newData.child('expiresAt').val() == 0 || newData.child('expiresAt').val() > now) && newData.child('hostPro').isBoolean())",
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && (newData.val() == 0 || newData.val() > now)"
          },
          "hostPro": {
            ".validate": "newData.isBoolean()"
          },
          "activatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "creatorPub": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512"
          },
          "icebreaker": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "$other": {
            ".validate": false
          }
        },
        "messages": {
          "$messageId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['ciphertext', 'senderPub', 'createdAt', 'expiresAt']) && newData.child('ciphertext').isString() && newData.child('ciphertext').val().length > 0 && newData.child('ciphertext').val().length <= 16384 && newData.child('senderPub').isString() && newData.child('senderPub').val().length > 0 && newData.child('senderPub').val().length <= 512 && newData.child('createdAt').isNumber() && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() > now)",
            "ciphertext": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16384"
            },
            "senderPub": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "expiresAt": {
              ".validate": "newData.isNumber() && newData.val() > now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          "$deviceId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['online', 'updatedAt']) && newData.child('online').isBoolean() && newData.child('updatedAt').isNumber())",
            "online": { ".validate": "newData.isBoolean()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "read": {
          "$deviceId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['messageId', 'updatedAt']) && newData.child('messageId').isString() && newData.child('messageId').val().length > 0 && newData.child('messageId').val().length <= 64 && newData.child('updatedAt').isNumber())",
            "messageId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "typing": {
          "$deviceId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['at']) && newData.child('at').isNumber())",
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "reactions": {
          "$messageId": {
            "$deviceId": {
              ".validate": "!newData.exists() || (newData.hasChildren(['emoji', 'at']) && newData.child('emoji').isString() && newData.child('emoji').val().length > 0 && newData.child('emoji').val().length <= 8 && newData.child('at').isNumber())",
              "emoji": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reports": {
      "$reportId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.hasChildren(['roomId', 'reporterPub', 'createdAt'])",
        "roomId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "reporterPub": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512"
        },
        "peerPub": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 512)"
        },
        "reason": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
