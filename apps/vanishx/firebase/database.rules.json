{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".validate": "!newData.exists() || (newData.hasChildren(['createdAt', 'expiresAt', 'hostPro']) && newData.child('createdAt').isNumber() && newData.child('expiresAt').isNumber() && (newData.child('expiresAt').val() == 0 || newData.child('expiresAt').val() > now) && newData.child('hostPro').isBoolean())",
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && (newData.val() == 0 || newData.val() > now)"
          },
          "hostPro": {
            ".validate": "newData.isBoolean()"
          },
          "activatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "creatorPub": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512"
          },
          "icebreaker": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "$other": {
            ".validate": false
          }
        },
        "messages": {
          "$messageId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['ciphertext', 'senderPub', 'createdAt', 'expiresAt']) && newData.child('ciphertext').isString() && newData.child('ciphertext').val().length > 0 && newData.child('ciphertext').val().length <= 16384 && newData.child('senderPub').isString() && newData.child('senderPub').val().length > 0 && newData.child('senderPub').val().length <= 512 && newData.child('createdAt').isNumber() && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() > now)",
            "ciphertext": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16384"
            },
            "senderPub": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "expiresAt": {
              ".validate": "newData.isNumber() && newData.val() > now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reports": {
      "$reportId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.hasChildren(['roomId', 'reporterPub', 'createdAt'])",
        "roomId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "reporterPub": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512"
        },
        "peerPub": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 512)"
        },
        "reason": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
