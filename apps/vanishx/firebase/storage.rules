rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Encrypted blobs only. Capability = knowing roomId (same MVP tradeoff as RTDB mailbox).
    match /rooms/{roomId}/att/{messageId}/{attId} {
      allow read, delete: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 40 * 1024 * 1024;
    }
  }
}
