{
  "functions": [
    {
      "source": "functions",
      "codebase": "vanishx",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "*.local"]
    }
  ],
  "hosting": {
    "public": "hosting",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "rewrites": [
      { "source": "/join", "destination": "/join/index.html" },
      { "source": "/join/**", "destination": "/join/index.html" },
      { "source": "/j/**", "destination": "/join/index.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/join/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
